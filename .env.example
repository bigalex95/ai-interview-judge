# Copy to .env and fill in. Variables not set fall back to the defaults in
# backend/core/config.py.

# Required for the LLM scoring step (Gemini). Without it the pipeline still
# runs, but "ai_evaluation" contains an error instead of a score.
GEMINI_API_KEY=

# Application settings
DEBUG=False
LOG_LEVEL=INFO

# Slide detection (defaults for backend.core.config.settings)
MIN_SCENE_DURATION=2.0
MIN_AREA_RATIO=0.15

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
