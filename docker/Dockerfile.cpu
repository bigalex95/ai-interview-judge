# ==========================================
# CPU-Optimized Version
# Stage 1: Builder (Compiling C++ Core)
# ==========================================
FROM python:3.11-slim AS builder

# Install build tools (GCC, CMake, OpenCV dev)
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the build configuration
COPY CMakeLists.txt .
COPY cpp_core/ ./cpp_core/

# Build the C++ module
# The result (.so file) ends up in /app/libs (as set in CMakeLists.txt)
RUN mkdir build && cd build && \
    cmake .. && \
    make -j$(nproc)

# ==========================================
# Stage 2: Runtime (Production Image - CPU)
# ==========================================
FROM python:3.11-slim

# Install runtime system dependencies (minimal set)
# ffmpeg - for Whisper/AudioService
# libgomp1 - for OpenMP (needed by Paddle)
# libopencv-dev reduced to the minimum
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libopencv-dev \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install 'uv' (fast package manager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app

# Copy the dependency files
COPY pyproject.toml uv.lock ./

# Install Python libraries
RUN uv sync --frozen

# Copy the compiled C++ library from Stage 1
COPY --from=builder /app/libs /app/libs

# Copy the backend source code
COPY backend/ ./backend/

# Pre-download ML models during build (so container doesn't need internet at runtime)
# 1. Download Whisper model
RUN uv run python -c "from faster_whisper import WhisperModel; WhisperModel('base', device='cpu', compute_type='int8')"

# 2. Download PaddleOCR models (detection + recognition)
RUN uv run python -c "from paddleocr import PaddleOCR; ocr = PaddleOCR(use_angle_cls=False, lang='en', use_gpu=False, show_log=False)"

# Create temporary directories
RUN mkdir -p temp_uploads temp_audio

# --- Environment setup ---

# 1. Resolve library conflicts (Torch vs Paddle)
ENV KMP_DUPLICATE_LIB_OK=TRUE
ENV FLAGS_use_mkldnn=0
ENV FLAGS_enable_mkldnn=0
ENV DNNL_VERBOSE=0

# 2. CPU-specific optimizations (set to 1 for PaddlePaddle compatibility)
ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1

# 3. Add the path to our C++ library so Python can 'import ai_interview_cpp'
ENV PYTHONPATH=/app:/app/libs

# 4. Disable log buffering (to see logs in real time)
ENV PYTHONUNBUFFERED=1

# Expose the port
EXPOSE 8000

# Start the server via uv run
CMD ["uv", "run", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
